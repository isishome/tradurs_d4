{
  "name": "d4-ssr",
  "version": "1.15.11",
  "description": "Diablo4 Trade App",
  "productName": "D4 App",
  "author": "SeraSome",
  "private": true,
  "scripts": {
    "test": "npm run check:ssr-source && npm run test:ocr:client && npm run test:consent && npm run test:attribute && npm run test:item-draft",
    "check:ssr-source": "node scripts/check-ssr-source.mjs",
    "test:ocr:client": "node --test tests/ocr/client.test.mjs tests/ocr/dev-deps.test.mjs",
    "test:consent": "node --test tests/consent/consent.test.mjs",
    "test:attribute": "node --test tests/attribute/attribute-text.test.mjs",
    "test:item-draft": "node --test tests/item-draft/item-draft-key.test.mjs",
    "test:ocr": "node tests/ocr/prepare.mjs && node --test tests/ocr/*.test.mjs",
    "test:performance": "node tests/performance/prepare.mjs && node --test tests/performance/*.test.mjs",
    "dev": "npx quasar dev -m ssr -p 6090",
    "typecheck": "quasar prepare && tsc --noEmit --skipLibCheck",
    "build": "npx quasar build -m ssr",
    "cypress": "npx cypress open",
    "postinstall": "npm ci --prefix src-ssr && quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "cropperjs": "^2.1.0",
    "onnxruntime-web": "1.30.0",
    "pinia": "3.0.4",
    "ppu-paddle-ocr": "6.6.0",
    "quasar": "2.35.2",
    "socket.io-client": "^4.7.5",
    "string-comparison": "^1.3.0",
    "vue": "^3.4.18",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@quasar/app-vite": "3.10.3",
    "@types/node": "^22.20.5",
    "@types/similarity": "^1.2.3",
    "autoprefixer": "^10.4.2",
    "cypress": "^15.12.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^24 || ^22.22.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "overrides": {
    "qs": "6.16.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "imports": {
    "#q-app": "@quasar/app-vite"
  },
  "type": "module"
}
